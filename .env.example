# Copy to .env and fill in. Never commit real values.
APP_URL=https://app.example.co.uk
APP_SECRET=generate-a-long-random-string        # encrypts stored credentials and signs OAuth state
CRON_SECRET=generate-another-random-string      # header for /api/cron/nightly and /api/cron/deliver
DATABASE_URL=postgres://rounds:rounds@localhost:5432/rounds

# Platform email (SMTP URL of your transactional provider, e.g. SES, Postmark, Resend)
SMTP_URL=smtps://user:pass@smtp.example.com:465
SMTP_FROM="Rounds <no-reply@example.co.uk>"

# SMS (optional): webex | esendex | httpsms
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM=
ESENDEX_ACCOUNT_REFERENCE=

# Maps and geocoding (optional; postcodes.io is used when unset)
MAPBOX_TOKEN=
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
IDEAL_POSTCODES_KEY=

# GoCardless partner app
GOCARDLESS_CLIENT_ID=
GOCARDLESS_CLIENT_SECRET=
GOCARDLESS_ENV=sandbox
GOCARDLESS_WEBHOOK_SECRET=

# Subscription billing for the product (platform Stripe account)
STRIPE_PLATFORM_KEY=
STRIPE_PLATFORM_WEBHOOK_SECRET=

# HMRC Making Tax Digital
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
HMRC_ENV=sandbox
SERVER_PUBLIC_IP=
APP_VERSION=0.1.0

# QuickBooks Online
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENV=sandbox

# Gmail / Outlook sending
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
